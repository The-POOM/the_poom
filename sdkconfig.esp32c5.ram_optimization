# Use PSRAM and external allocations
# [disabled: board has no PSRAM] CONFIG_SPIRAM=y
# [disabled: board has no PSRAM] CONFIG_SPIRAM_MODE_QUAD=y
# [disabled: board has no PSRAM] CONFIG_SPIRAM_SPEED_80M=y
# [disabled: board has no PSRAM] CONFIG_SPIRAM_USE_MALLOC=y

# [disabled: board has no PSRAM] CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# [disabled: board has no PSRAM] CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# [disabled: board has no PSRAM] CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Network stacks
# [disabled: board has no PSRAM] CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# [disabled: board has no PSRAM] CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# [disabled: board has no PSRAM] CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
# [disabled: board has no PSRAM] CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# OpenThread allocations in PSRAM
# [disabled: board has no PSRAM] CONFIG_OPENTHREAD_PLATFORM_MALLOC_CAP_SPIRAM=y
# [disabled: board has no PSRAM] CONFIG_OPENTHREAD_PLATFORM_MSGPOOL_MANAGEMENT=y

# Disable Groupcast cluster until verified
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
# Optimize for size (OpenThread build overflows app partition at -Og)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
